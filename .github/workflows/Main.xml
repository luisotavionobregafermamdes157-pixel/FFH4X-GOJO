package com.ffcheat;

import android.app.Activity;
import android.os.Bundle;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.TextView;
import android.widget.Toast;
import android.graphics.Color;
import android.view.Gravity;

public class MainActivity extends Activity {
    
    static {
        System.loadLibrary("ffcheat");
    }
    
    private native boolean initialize();
    private native boolean injectCheat(String packageName);
    private native void stopCheat();
    private native boolean checkAntiBan();
    
    private boolean isRunning = false;
    
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        
        // Interface do usuário
        LinearLayout layout = new LinearLayout(this);
        layout.setOrientation(LinearLayout.VERTICAL);
        layout.setGravity(Gravity.CENTER);
        layout.setBackgroundColor(Color.parseColor("#1a1a2e"));
        
        // Título
        TextView title = new TextView(this);
        title.setText("FF CHEAT INJECTOR");
        title.setTextColor(Color.WHITE);
        title.setTextSize(24);
        title.setGravity(Gravity.CENTER);
        title.setPadding(0, 50, 0, 30);
        
        // Botão de injeção
        Button btnInject = new Button(this);
        btnInject.setText("INICIAR CHEAT");
        btnInject.setBackgroundColor(Color.parseColor("#e94560"));
        btnInject.setTextColor(Color.WHITE);
        btnInject.setTextSize(18);
        btnInject.setPadding(50, 20, 50, 20);
        
        // Botão de parada
        Button btnStop = new Button(this);
        btnStop.setText("PARAR CHEAT");
        btnStop.setBackgroundColor(Color.parseColor("#16213e"));
        btnStop.setTextColor(Color.WHITE);
        btnStop.setTextSize(18);
        btnStop.setPadding(50, 20, 50, 20);
        
        // Status
        TextView status = new TextView(this);
        status.setText("Status: Pronto");
        status.setTextColor(Color.parseColor("#0f3460"));
        status.setTextSize(16);
        status.setGravity(Gravity.CENTER);
        status.setPadding(0, 30, 0, 0);
        
        // Ações dos botões
        btnInject.setOnClickListener(v -> {
            if (!isRunning) {
                if (checkRootAccess()) {
                    if (initialize()) {
                        if (injectCheat("com.dts.freefireth")) {
                            isRunning = true;
                            status.setText("Status: Cheat Ativo");
                            status.setTextColor(Color.GREEN);
                            Toast.makeText(this, "Cheat injetado com sucesso!", Toast.LENGTH_LONG).show();
                        } else {
                            Toast.makeText(this, "Falha na injeção!", Toast.LENGTH_LONG).show();
                        }
                    }
                } else {
                    Toast.makeText(this, "Requer acesso ROOT!", Toast.LENGTH_LONG).show();
                }
            }
        });
        
        btnStop.setOnClickListener(v -> {
            if (isRunning) {
                stopCheat();
                isRunning = false;
                status.setText("Status: Parado");
                status.setTextColor(Color.RED);
                Toast.makeText(this, "Cheat parado!", Toast.LENGTH_SHORT).show();
            }
        });
        
        // Adicionar elementos ao layout
        layout.addView(title);
        layout.addView(btnInject);
        layout.addView(btnStop);
        layout.addView(status);
        
        setContentView(layout);
    }
    
    private boolean checkRootAccess() {
        try {
            Process process = Runtime.getRuntime().exec("su");
            process.waitFor();
            return process.exitValue() == 0;
        } catch (Exception e) {
            return false;
        }
    }
}
