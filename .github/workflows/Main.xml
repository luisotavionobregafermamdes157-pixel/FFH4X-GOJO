#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)

// Estrutura para injeção
typedef struct {
    pid_t pid;
    void* remote_addr;
    char* lib_path;
} InjectContext;

// Encontrar processo do jogo
pid_t findProcess(const char* packageName) {
    pid_t pid = -1;
    FILE* fp = fopen("/proc/self/status", "r");
    
    // Busca pelo processo
    char cmdline[256];
    char path[64];
    
    for (int i = 0; i < 1000; i++) {
        sprintf(path, "/proc/%d/cmdline", i);
        FILE* cmd = fopen(path, "r");
        if (cmd) {
            fgets(cmdline, sizeof(cmdline), cmd);
            if (strstr(cmdline, packageName)) {
                pid = i;
                break;
            }
            fclose(cmd);
        }
    }
    
    return pid;
}

// Função de injeção via ptrace
int injectLibrary(pid_t target_pid, const char* library_path) {
    // 1. Anexar ao processo
    if (ptrace(PTRACE_ATTACH, target_pid, NULL, NULL) == -1) {
        LOGE("Falha ao anexar ao processo");
        return -1;
    }
    
    waitpid(target_pid, NULL, 0);
    
    // 2. Obter registradores
    struct pt_regs regs;
    if (ptrace(PTRACE_GETREGS, target_pid, NULL, &regs) == -1) {
        LOGE("Falha ao obter registradores");
        ptrace(PTRACE_DETACH, target_pid, NULL, NULL);
        return -1;
    }
    
    // 3. Alocar memória no processo alvo
    void* remote_addr = (void*)0x70000000;
    
    // 4. Escrever o caminho da biblioteca
    char lib_path[256];
    strcpy(lib_path, library_path);
    
    for (size_t i = 0; i < strlen(lib_path); i++) {
        ptrace(PTRACE_POKEDATA, target_pid, (void*)((char*)remote_addr + i), lib_path[i]);
    }
    
    // 5. Chamar dlopen no processo alvo
    // (Implementação complexa - requer shellcode)
    
    // 6. Desanexar
    ptrace(PTRACE_DETACH, target_pid, NULL, NULL);
    
    LOGI("Biblioteca injetada com sucesso!");
    return 0;
}

