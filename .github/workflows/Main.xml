extern "C" JNIEXPORT jboolean JNICALL
Java_com_ffcheat_MainActivity_injectCheat(JNIEnv* env, jobject thiz, jstring packageName) {
    const char* pkg = (*env)->GetStringUTFChars(env, packageName, NULL);
    
    pid_t target_pid = findProcess(pkg);
    if (target_pid <= 0) {
        LOGE("Processo não encontrado: %s", pkg);
        return JNI_FALSE;
    }
    
    // Caminho da biblioteca
    const char* lib_path = "/data/data/com.ffcheat/lib/libffcheat.so";
    
    if (injectLibrary(target_pid, lib_path) == 0) {
        return JNI_TRUE;
    }
    
    return JNI_FALSE;
}

